# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- Model access ---------------------------------------------------------
# Required. Startup aborts if this is absent.
ANTHROPIC_API_KEY=

# claude-sonnet-5 is the default: five agents per composite request makes
# per-call cost a design constraint. Use claude-opus-5 when evaluating answer
# quality, and record which model produced any benchmark numbers.
MODEL=claude-sonnet-5

# --- Dependencies ---------------------------------------------------------
# Host values. docker-compose overrides these with service names.
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8000

# --- Runtime --------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# Ceiling on concurrent Anthropic calls (LLMGateway semaphore). Composite
# requests fan out, so this is the backpressure knob.
LLM_MAX_CONCURRENCY=8

# Wall-clock ceiling on one model call, covering the wait for a semaphore slot
# as well as the request. The SDK's own default is ten minutes and it retries
# timeouts, so this is enforced separately to be the number it says.
LLM_TIMEOUT_SECONDS=60

# Seed the Chroma-backed intent template index at startup. Off runs intent
# recognition on two signals instead of three; fusion renormalises, so the
# thresholds still mean what they say.
INTENT_INDEX_ENABLED=true
